# Set these in your shell; this file is documentation, not loaded automatically.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Shared backend (Supabase or any Postgres + S3-compatible bucket). Leave unset for local mode.
# Use the Supabase *session* pooler connection string (port 5432).
RH_DATABASE_URL=
RH_DATABASE_SCHEMA=research_harness
RH_BLOB_BUCKET=research-harness
RH_BLOB_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
RH_BLOB_REGION=us-east-1
RH_BLOB_ACCESS_KEY=
RH_BLOB_SECRET_KEY=
# Local mode only: where the registry and id-run pipelines keep their data.
RH_LOCAL_ROOT=.researchharness
